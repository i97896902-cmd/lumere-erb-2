rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Global default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string
        && id.size() >= 1
        && id.size() <= 128
        && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'SUPER_ADMIN'
        || (request.auth.token.email == 'lumerecompany@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    function belongsToCompany(companyId) {
      return isSignedIn()
        && isValidId(companyId)
        && request.auth.token.companyId is string
        && request.auth.token.companyId == companyId;
    }

    function isCompanyAdmin(companyId) {
      return belongsToCompany(companyId) && request.auth.token.role == 'COMPANY_ADMIN';
    }

    function isSafeImage() {
      return request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    function isSafeAttachment() {
      return request.resource != null
        && request.resource.size < 15 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf'
          || request.resource.contentType.matches('application/vnd\\..*')
          || request.resource.contentType == 'application/msword'
          || request.resource.contentType == 'text/plain'
          || request.resource.contentType == 'text/csv'
        );
    }

    // Company Logos: strictly isolated to the company and SUPER_ADMIN
    match /companies/{companyId}/logos/{fileName} {
      allow read: if isValidId(companyId) && (isSuperAdmin() || belongsToCompany(companyId));
      allow create, update: if isValidId(companyId) && (isSuperAdmin() || isCompanyAdmin(companyId)) && isSafeImage();
      allow delete: if isValidId(companyId) && (isSuperAdmin() || isCompanyAdmin(companyId));
    }

    // Task attachments: strictly isolated to the company
    match /companies/{companyId}/tasks/{taskId}/{fileName} {
      allow read: if isValidId(companyId) && isValidId(taskId) && (isSuperAdmin() || belongsToCompany(companyId));
      allow create, update: if isValidId(companyId) && isValidId(taskId) && (isSuperAdmin() || belongsToCompany(companyId)) && isSafeAttachment();
      allow delete: if isValidId(companyId) && isValidId(taskId) && (isSuperAdmin() || isCompanyAdmin(companyId));
    }

    // Project files: strictly isolated to the company
    match /companies/{companyId}/projects/{projectId}/{fileName} {
      allow read: if isValidId(companyId) && isValidId(projectId) && (isSuperAdmin() || belongsToCompany(companyId));
      allow create, update: if isValidId(companyId) && isValidId(projectId) && (isSuperAdmin() || belongsToCompany(companyId)) && isSafeAttachment();
      allow delete: if isValidId(companyId) && isValidId(projectId) && (isSuperAdmin() || isCompanyAdmin(companyId));
    }

    // User avatars: isolated by companyId and userId
    match /companies/{companyId}/avatars/{userId}/{fileName} {
      allow read: if isValidId(companyId) && isValidId(userId) && (isSuperAdmin() || belongsToCompany(companyId));
      allow create, update: if isValidId(companyId) && isValidId(userId) && (isSuperAdmin() || (belongsToCompany(companyId) && request.auth.uid == userId)) && isSafeImage();
      allow delete: if isValidId(companyId) && isValidId(userId) && (isSuperAdmin() || isCompanyAdmin(companyId) || (belongsToCompany(companyId) && request.auth.uid == userId));
    }
  }
}
