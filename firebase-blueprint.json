{
  "entities": {
    "Company": {
      "title": "Company",
      "description": "Parent holding company (LUMERE GROUP) or subsidiary company (LUMERE, NEX AURA, ORDARK, etc.)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "arabicName": { "type": "string", "maxLength": 150 },
        "slug": { "type": "string", "maxLength": 100 },
        "type": { "type": "string", "enum": ["parent", "subsidiary"] },
        "parentCompanyId": { "type": ["string", "null"], "maxLength": 128 },
        "logo": { "type": "string", "maxLength": 2048 },
        "description": { "type": "string", "maxLength": 1000 },
        "businessSector": { "type": "string", "maxLength": 200 },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "adminIds": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "slug", "type", "status"]
    },
    "User": {
      "title": "User",
      "description": "Multi-company Luméré Group user profile with 4-tier role-based access control",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "uid": { "type": "string", "maxLength": 128 },
        "companyId": { "type": "string", "maxLength": 128 },
        "companyName": { "type": "string", "maxLength": 150 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 1024 },
        "role": { "type": "string", "enum": ["SUPER_ADMIN", "COMPANY_ADMIN", "MANAGER", "EMPLOYEE", "ADMIN"] },
        "department": { "type": "string", "maxLength": 100 },
        "position": { "type": "string", "maxLength": 100 },
        "managerId": { "type": "string", "maxLength": 128 },
        "managerName": { "type": "string", "maxLength": 128 },
        "phone": { "type": "string", "maxLength": 30 },
        "status": { "type": "string", "enum": ["pending", "active", "rejected", "suspended", "Active", "Inactive", "Suspended"] },
        "joinedDate": { "type": "string", "maxLength": 50 },
        "approvedBy": { "type": "string", "maxLength": 128 },
        "approvedByName": { "type": "string", "maxLength": 128 },
        "approvedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["companyId", "email", "displayName", "role", "status"]
    },
    "Client": {
      "title": "Client",
      "description": "Company-scoped commercial client profile",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "companyId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "maxLength": 256 },
        "companyName": { "type": "string", "maxLength": 200 },
        "clientType": { "type": "string", "enum": ["company", "restaurant", "cafe", "store", "individual", "other", "corporate"] },
        "address": { "type": "string", "maxLength": 500 },
        "notes": { "type": "string", "maxLength": 3000 },
        "assignedEmployeeId": { "type": "string", "maxLength": 128 },
        "assignedEmployeeName": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["companyId", "name", "phone", "email", "clientType", "address"]
    },
    "Project": {
      "title": "Project",
      "description": "Company-scoped client project",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "companyId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "clientId": { "type": "string", "maxLength": 128 },
        "clientName": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 5000 },
        "projectType": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["not_started", "in_progress", "in_review", "review", "planning", "completed", "on_hold", "cancelled"] },
        "startDate": { "type": "string", "maxLength": 50 },
        "deliveryDate": { "type": "string", "maxLength": 50 },
        "projectManagerId": { "type": "string", "maxLength": 128 },
        "projectManagerName": { "type": "string", "maxLength": 128 },
        "teamMemberIds": { "type": "array", "items": { "type": "string" } },
        "completionPercentage": { "type": "number" },
        "budget": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["companyId", "name", "clientId", "status", "startDate", "deliveryDate"]
    },
    "Task": {
      "title": "Task",
      "description": "Company-scoped operational work task",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "companyId": { "type": "string", "maxLength": 128 },
        "taskId": { "type": "string", "maxLength": 30 },
        "title": { "type": "string", "maxLength": 256 },
        "description": { "type": "string", "maxLength": 5000 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdByName": { "type": "string", "maxLength": 128 },
        "assignedTo": { "type": "string", "maxLength": 128 },
        "assignedToName": { "type": "string", "maxLength": 128 },
        "assignedToEmail": { "type": "string", "maxLength": 256 },
        "department": { "type": "string", "maxLength": 100 },
        "priority": { "type": "string", "enum": ["Low", "Medium", "High", "Urgent"] },
        "status": { "type": "string", "enum": ["Pending", "In Progress", "Review", "Completed", "Rejected", "Cancelled"] },
        "startDate": { "type": "string", "maxLength": 50 },
        "deadline": { "type": "string", "maxLength": 50 },
        "completedAt": { "type": "string", "maxLength": 50 },
        "completionPercentage": { "type": "number" },
        "reviewStatus": { "type": "string", "enum": ["none", "pending_review", "approved", "rejected"] },
        "clientId": { "type": "string", "maxLength": 128 },
        "projectId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["companyId", "title", "description", "department", "priority", "status", "deadline"]
    },
    "Comment": {
      "title": "Comment",
      "description": "Company-scoped discussion item on a specific task",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "companyId": { "type": "string", "maxLength": 128 },
        "taskId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 128 },
        "userRole": { "type": "string", "maxLength": 50 },
        "userAvatar": { "type": "string", "maxLength": 1024 },
        "message": { "type": "string", "maxLength": 3000 },
        "attachmentName": { "type": "string", "maxLength": 256 },
        "attachmentUrl": { "type": "string", "maxLength": 2048 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["companyId", "taskId", "userId", "userName", "message"]
    },
    "Department": {
      "title": "Department",
      "description": "Company-scoped organizational department",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "companyId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 500 },
        "managerId": { "type": "string", "maxLength": 128 },
        "managerName": { "type": "string", "maxLength": 128 },
        "color": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["companyId", "name"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Company-scoped user event notification alert",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "companyId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 1000 },
        "type": { "type": "string", "enum": ["task_assigned", "deadline_approaching", "task_rejected", "task_approved", "comment_added", "task_reassigned", "join_approved", "join_rejected", "client_created", "project_created", "company_updated", "system"] },
        "relatedTaskId": { "type": "string", "maxLength": 128 },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["companyId", "userId", "title", "message", "type", "read"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Company-scoped immutable audit trail",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "companyId": { "type": "string", "maxLength": 128 },
        "actorId": { "type": "string", "maxLength": 128 },
        "actorName": { "type": "string", "maxLength": 128 },
        "actorRole": { "type": "string", "maxLength": 50 },
        "action": { "type": "string", "maxLength": 100 },
        "target": { "type": "string", "maxLength": 200 },
        "targetId": { "type": "string", "maxLength": 128 },
        "metadata": { "type": "string", "maxLength": 1000 },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["companyId", "actorId", "actorName", "action", "target"]
    },
    "AdminDoc": {
      "title": "AdminDoc",
      "description": "Server-managed list of trusted super administrator UIDs",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid"]
    },
    "Equipment": {
      "title": "Equipment",
      "description": "Company-scoped equipment and asset inventory",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "companyId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "type": { "type": "string", "maxLength": 100 },
        "serialNumber": { "type": "string", "maxLength": 100 },
        "assetId": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 2000 },
        "status": { "type": "string", "enum": ["available", "assigned", "in_maintenance", "damaged", "lost", "inactive"] },
        "assignedTo": { "type": "string", "maxLength": 128 },
        "assignedToName": { "type": "string", "maxLength": 128 },
        "assignedToEmail": { "type": "string", "maxLength": 256 },
        "projectId": { "type": "string", "maxLength": 128 },
        "projectName": { "type": "string", "maxLength": 200 },
        "purchaseDate": { "type": "string", "maxLength": 50 },
        "receivedDate": { "type": "string", "maxLength": 50 },
        "value": { "type": "number" },
        "notes": { "type": "string", "maxLength": 2000 },
        "photoURL": { "type": "string", "maxLength": 2048 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["companyId", "name", "type", "serialNumber", "status"]
    },
    "EquipmentHistory": {
      "title": "EquipmentHistory",
      "description": "Company-scoped immutable log tracking assignment and lifecycle of equipment",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "companyId": { "type": "string", "maxLength": 128 },
        "equipmentId": { "type": "string", "maxLength": 128 },
        "equipmentName": { "type": "string", "maxLength": 200 },
        "action": { "type": "string", "enum": ["created", "assigned", "returned", "maintenance_in", "maintenance_out", "status_change", "updated"] },
        "assignedToId": { "type": "string", "maxLength": 128 },
        "assignedToName": { "type": "string", "maxLength": 128 },
        "returnedById": { "type": "string", "maxLength": 128 },
        "returnedByName": { "type": "string", "maxLength": 128 },
        "projectId": { "type": "string", "maxLength": 128 },
        "projectName": { "type": "string", "maxLength": 200 },
        "previousStatus": { "type": "string", "maxLength": 50 },
        "newStatus": { "type": "string", "maxLength": 50 },
        "notes": { "type": "string", "maxLength": 2000 },
        "actorId": { "type": "string", "maxLength": 128 },
        "actorName": { "type": "string", "maxLength": 128 },
        "actorRole": { "type": "string", "maxLength": 50 },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["companyId", "equipmentId", "equipmentName", "action", "actorId", "actorName", "timestamp"]
    }
  },
  "firestore": {
    "/companies/{companyId}": {
      "schema": "Company",
      "description": "Parent holding company (LUMERE GROUP) and subsidiaries"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Multi-company user accounts with 4-tier RBAC roles and company ownership"
    },
    "/admins/{adminId}": {
      "schema": "AdminDoc",
      "description": "Super administrator UID verification map"
    },
    "/clients/{clientId}": {
      "schema": "Client",
      "description": "Company-scoped clients directory"
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Company-scoped client projects portfolio"
    },
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "Company-scoped task management records"
    },
    "/tasks/{taskId}/comments/{commentId}": {
      "schema": "Comment",
      "description": "Company-scoped task discussion comments"
    },
    "/departments/{departmentId}": {
      "schema": "Department",
      "description": "Company-scoped organizational departments"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Company-scoped targeted user notifications"
    },
    "/activity_logs/{logId}": {
      "schema": "ActivityLog",
      "description": "Company-scoped immutable activity audit trail"
    },
    "/equipment/{equipmentId}": {
      "schema": "Equipment",
      "description": "Company-scoped equipment and asset inventory"
    },
    "/equipmentHistory/{historyId}": {
      "schema": "EquipmentHistory",
      "description": "Company-scoped immutable equipment assignment and maintenance history"
    }
  }
}
